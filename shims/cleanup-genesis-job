#!/bin/sh
# Remove one completed GENESIS task folder, never the shared root or another directory.
set -eu

BASE=/data/genesis
TASK=$(cat)
case "$TASK" in
  "$BASE"/*) NAME=${TASK#"$BASE"/} ;;
  *) echo 'cleanup refused: path is outside /data/genesis' >&2; exit 2 ;;
esac
case "$NAME" in
  ''|.|..|*/*|*..*) echo 'cleanup refused: expected one direct task folder' >&2; exit 2 ;;
esac
TARGET="$BASE/$NAME"
[ -d "$TARGET" ] || { echo 'cleanup skipped: task folder already absent'; exit 0; }
[ ! -L "$TARGET" ] || { echo 'cleanup refused: task folder is a symlink' >&2; exit 2; }
REAL_BASE=$(realpath "$BASE")
REAL_TARGET=$(realpath "$TARGET")
[ "$REAL_TARGET" = "$REAL_BASE/$NAME" ] || { echo 'cleanup refused: canonical path mismatch' >&2; exit 2; }
case "$REAL_TARGET" in
  "$REAL_BASE"/*) ;;
  *) echo 'cleanup refused: resolved path escaped task root' >&2; exit 2 ;;
esac
rm -rf -- "$REAL_TARGET"
echo 'cleanup complete: finished GENESIS task folder removed'


# секреты и локальное состояние сервера — никогда не коммитим
.env
.env.*
!.env.template
bot/.env
*.bak
*.bak.*
*.bak_*
*.save
*.orig
*.log
backup.log
default

# данные, бэкапы, сертификаты, логи
data/
backups/
logs/
letsencrypt/
traefik_dynamic/
docker-plugins/

# зависимости
node_modules/
bot/node_modules/
engines/*/node_modules/

# локальные копии документации сервера
SERVER_PROFILE.md

# коллекция шрифтов: качается scripts/install-fonts.sh, свои шрифты — в fonts/custom
fonts/google/
fonts/.src/
fonts/custom/*
!fonts/custom/.gitkeep
fonts/fonts.css
fonts/fonts.json

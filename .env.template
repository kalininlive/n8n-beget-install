# ============================================================
# n8n-beget-install — шаблон .env (копируется install.sh в /opt/n8n-install/.env)
# Все секреты только здесь. В docker-compose*.yml — только ${ПЕРЕМЕННЫЕ}.
# ============================================================

# === Основные настройки ===
DOMAIN=your.domain.com
EMAIL=your@email.com
POSTGRES_PASSWORD=your_postgres_password
N8N_ENCRYPTION_KEY=
N8N_EXPRESS_TRUST_PROXY=true
N8N_TRUSTED_PROXIES=*
N8N_PROXY_HOPS=1
WEBHOOK_URL=https://your.domain.com/

# === Telegram-бот (уведомления, /status, /backups, /update) ===
TG_BOT_TOKEN=your_bot_token
TG_USER_ID=your_user_id

# === Хранение бинарных данных n8n ===
N8N_BINARY_DATA_MODE=filesystem
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# === Queue mode (n8n-app + n8n-worker через Redis) ===
EXECUTIONS_PROCESS=queue
QUEUE_BULL_REDIS_HOST=n8n-redis
QUEUE_BULL_REDIS_PORT=6379
EXECUTIONS_RECOVERY_ENABLED=true
N8N_CONCURRENCY=10

# === Внешний HTTP-прокси (оставьте PROXY_URL пустым, если прокси не нужен) ===
PROXY_URL=
# ЖЕЛЕЗНОЕ ПРАВИЛО: имя КАЖДОГО внутреннего сервиса docker — в начало NO_PROXY,
# иначе n8n пойдёт к нему через внешний прокси и получит 502 Bad Gateway.
NO_PROXY=edge-tts,sandbox-api,sandbox-runner-1,searxng,n8n-media-render,n8n-tools,n8n-postgres,n8n-redis,localhost,127.0.0.1,::1

# === n8n AI Sandbox Service (install-extras.sh генерирует значения сам) ===
# SANDBOX_API_KEYS и N8N_SANDBOX_SERVICE_API_KEY — одно и то же значение (sbx_…)
# SANDBOX_API_RUNNER_REGISTRATION_TOKEN и SANDBOX_RUNNER_REGISTRATION_TOKEN — одно и то же (reg_…), иначе раннер не стартует
# SANDBOX_API_RUNNER_API_KEY и SANDBOX_RUNNER_API_KEYS — одно и то же (rnk_…)
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
SANDBOX_RUNNER_API_KEYS=
SANDBOX_RUNNER_REGISTRATION_TOKEN=
N8N_SANDBOX_SERVICE_API_KEY=
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080

# === SearXNG Web Search для n8n AI Assistant (секрет генерирует install-extras.sh) ===
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# === n8n-media-render: ключи внешних API для движка маскота (Pixabay b-roll; можно оставить пустым) ===
PIXABAY_API_KEY=
